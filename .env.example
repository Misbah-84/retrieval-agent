# ==========================================
# Retrieval Agent Configuration
# ==========================================

# OpenAI API Key (Required for live LLM reasoning and OpenAI embeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model Name
# Recommended: gpt-4o-mini (fast & low cost) or gpt-4o (high capability)
OPENAI_MODEL=gpt-4o-mini

# Conversation Memory Window Size (Number of dialogue turns retained)
MAX_MEMORY_TURNS=5

# Agent Max Iterations per turn (Prevents infinite tool-calling loops)
MAX_AGENT_ITERATIONS=8

# Optional: Set to 'true' to use OpenAI dense embeddings (text-embedding-3-small)
# When 'false' or unset, the agent uses the local zero-dependency TF-IDF cosine retriever.
USE_OPENAI_EMBEDDINGS=false
